.venv/
.venv-backend/
__pycache__/
*.pyc
.pytest_cache/
.env
.claude/

# Рабочие заметки по завершению проекта — только локально, не для сдачи
finalization/

# Сырые/распакованные данные и обучающие артефакты — не публиковать (раздел ТЗ: закрытые данные)
dataset/*.csv
dataset/*.7z
artifacts/*.parquet
artifacts/*.cbm
artifacts/*.joblib

# CatBoost создаёт эту папку сама при каждом запуске scripts/train_model*.py (логи обучения,
# чекпойнты) — не входной и не выходной артефакт, ничего не теряется при исключении.
catboost_info/

# ВНИМАНИЕ: шесть файлов ниже НЕ игнорируются, хотя и подходят под маски выше — это
# намеренный демокомплект (см. scripts/register_model_version.py, шаг 2): worker монтирует
# ./artifacts как volume и без них не запускается, а полный пайплайн обучения на 16 ГБ сырых
# журналов недоступен без dataset/*.csv. Уже отслеживаемый git-файл не перестаёт
# отслеживаться из-за маски в .gitignore — маски выше действуют только на новые файлы
# (промежуточные артефакты обучения: episode_evaluation_*, model_report_*, calibration_*,
# features_*.parquet, scored_*.parquet и т.п. — они регенерируются заново на каждой версии
# модели и не входят в демокомплект).
!artifacts/catboost_дым_газ.cbm
!artifacts/catboost_насос_вентилятор.cbm
!artifacts/isolation_forest_дым_газ.joblib
!artifacts/isolation_forest_насос_вентилятор.joblib
!artifacts/replay_feed_дым_газ.parquet
!artifacts/replay_feed_насос_вентилятор.parquet

frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

backups/

.DS_Store
