# Скопировать в .env рядом с docker-compose.yml и заполнить реальными значениями.
# .env в git не коммитится (см. .gitignore) — секреты только на сервере.

# Пароль пользователя Postgres (jkh). Генерировать случайно на проде, не использовать
# значение по умолчанию из docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Секрет для подписи JWT (см. app/core/security.py). Генерировать случайно на проде:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me

# Домен, на который Caddy получает TLS-сертификат Let's Encrypt (deploy/docker-compose.prod.yml).
# Должен указывать A-записью на IP сервера ДО первого запуска — иначе выпуск сертификата
# не пройдёт.
DOMAIN=jkh.example.ru

# Пауза между тиками фонового worker'а (replay + живой инференс), секунды.
REPLAY_SLEEP_SECONDS=2

# Ключ для краткого резюме прогноза на естественном языке в карточке риска
# (app/services/llm_summary.py, провайдер — GigaChat от Sber). Не обязателен — без него
# карточка просто не показывает этот блок. GIGACHAT_CREDENTIALS — это Authorization key
# из личного кабинета GigaChat API (developers.sber.ru/studio/workspaces, раздел API),
# строка вида base64(client_id:client_secret), НЕ сам access-токен — SDK сам обменивает
# его на короткоживущий токен. GIGACHAT_SCOPE — тариф: GIGACHAT_API_PERS для физлица
# (бесплатная квота), GIGACHAT_API_B2B/CORP для юрлица — см. личный кабинет.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
